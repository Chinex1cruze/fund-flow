# FundFlow environment variables example
# Copy this file to .env and set values before starting the server.

# Server
PORT=3000
NODE_ENV=development

# Secrets (generate strong random values for production)
JWT_SECRET=replace_with_strong_random_secret
ADMIN_TOKEN=replace_with_strong_admin_token

# Payment settings
# Leave PAYMENT_MODE=testing for evening launch (uses mock account verification)
PAYMENT_MODE=testing
# Paystack live keys (server-side secret stays on the host; public key is safe to expose to the browser)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PREFERRED_BANK=wema-bank
# For production, set PAYMENT_MODE=production and configure the provider below
PAYMENT_PROVIDER_API_URL=
PAYMENT_PROVIDER_API_KEY=

# Optional overrides for displayed funding account (also stored in data/store.json defaults):
PAYMENT_BANK_NAME=Access bank
PAYMENT_ACCOUNT_NUMBER=1909738593
PAYMENT_ACCOUNT_NAME=chinedu Chima

# Notes:
# - Never commit real secrets into source control. Use a secure secrets manager or environment variables on the host.
# - Use strong random values for JWT_SECRET and ADMIN_TOKEN. Example (Linux/macOS):
#     head -c32 /dev/urandom | base64
# - On Windows PowerShell (temporary env while starting):
#     $env:ADMIN_TOKEN='your-token'; $env:JWT_SECRET='your-secret'; node server.js
